# CORS-1 — use 127.0.0.1, NOT localhost. On this stack `localhost` can resolve
# to `::1` (IPv6) first; if another local service (observed: Docker Desktop)
# is already bound to `[::]:8000`, the desktop app silently talks to THAT
# service instead of Laravel (a 404 from nginx, not from this API), and
# nothing in the error says why. 127.0.0.1 forces IPv4 and reaches Laravel's
# `php artisan serve`, which only binds IPv4 by default.
VITE_API_URL=http://127.0.0.1:8000
VITE_REVERB_APP_KEY=syncra-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
