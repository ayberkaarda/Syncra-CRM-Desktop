APP_NAME=Syncra
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS-1 — the desktop webview is a DIFFERENT origin than the SPA and is not
# covered by FRONTEND_URL above; config/cors.php merges both lists. Without
# this, preflight from the Tauri app fails with no server-side clue (the
# browser just blocks the response).
#   http://localhost:1420   `tauri dev` (Vite dev server bundled with the app)
#   http://tauri.localhost  packaged/bundled build on Windows
# Comma-separated, no spaces. Add a platform origin here (e.g. Linux's
# `tauri://localhost`) rather than editing config/cors.php.
#
# Do NOT add these to SANCTUM_STATEFUL_DOMAINS below — see the warning there
# (KARAR A12). CORS and "stateful" are separate decisions.
DESKTOP_ORIGINS=http://localhost:1420,http://tauri.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syncra_crm
DB_USERNAME=root
DB_PASSWORD=
# MariaDB icin gerekli - Laravel varsayilani utf8mb4_0900_ai_ci MySQL 8e ozgudur
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum SPA (cookie) mode: ONLY the web front-end origins belong here.
#
# TRAP (Faz F1 / protokol §3.8) — the Syncra Desktop origin must NEVER be added.
# EnsureFrontendRequestsAreStateful decides statefulness from the Origin/Referer
# header alone. If the Tauri webview's origin (on Windows `http://tauri.localhost`,
# on Linux `tauri://localhost`) matched an entry here, its bearer-token requests
# would be treated as session requests, ValidateCsrfToken would engage, and every
# POST - `/api/broadcasting/auth` first - would fail with 419 CSRF_TOKEN_MISMATCH
# while carrying a perfectly valid token. The failure looks like an auth bug and
# is nowhere near this line, which is why it is written down here.
#
# In development, do not serve the desktop app from the same origin as Vite for
# the same reason.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Faz F1 — connection-level InnoDB lock wait (protokol §2.4/P4a). Applied via
# PDO::MYSQL_ATTR_INIT_COMMAND in config/database.php, so it is deterministic
# regardless of the server's own my.cnf. The engine default is 50s; 10s turns
# sync-counter contention into a fast, retryable error instead of a hung worker.
DB_LOCK_WAIT_TIMEOUT=10

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=syncra
REVERB_APP_KEY=syncra-key
REVERB_APP_SECRET=syncra-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
